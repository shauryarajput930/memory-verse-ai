# Supabase project URL and secret key. Keep the secret key private.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Optional PostgreSQL URLs. Replace [YOUR-PASSWORD] with the URL-encoded database password.
# The current backend does not use these URLs.
DATABASE_URL="postgresql://postgres.kvynvwxqwrtwmwmkmxak:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.kvynvwxqwrtwmwmkmxak:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Groq API key
GROQ_API_KEY=

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin allowed by the backend CORS policy
FRONTEND_URL=

# Optional: Tesseract executable path when it is not on PATH
TESSERACT_PATH=

# Redis Cache Configuration (Option 1: separate parameters, Option 2: single REDIS_URL)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

